---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPage from '../components/LegalPage.astro';
---

<BaseLayout title="Rivalo Support">
  <LegalPage title="Support">
    <p>Need help with Rivalo? This is the official support page for the app.</p>
    <h2>Common help topics</h2>
    <ul>
      <li>Pair your Apple Watch and open Rivalo on both devices before starting a match.</li>
      <li>Allow Health permissions to record heart rate, distance, energy, and workout activity.</li>
      <li>If a match does not sync immediately, reopen the iPhone app while the Watch is nearby.</li>
      <li>For account, data, or support requests, contact us by email.</li>
    </ul>
    <h2>Contact</h2>
    <p>Email: support@rivalo.app</p>
  </LegalPage>
</BaseLayout>
