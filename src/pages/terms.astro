---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPage from '../components/LegalPage.astro';
---

<BaseLayout title="Rivalo Terms of Use">
  <LegalPage title="Terms of Use" updated="June 2, 2026">
    <h2>Use of Rivalo</h2>
    <p>Rivalo provides football activity tracking and performance summaries. The app is not medical advice and should not be used as a substitute for professional guidance.</p>
    <h2>Your responsibility</h2>
    <p>Use Rivalo safely, follow local rules where you play, and stop activity if you feel pain, dizziness, or unsafe conditions.</p>
    <h2>Availability</h2>
    <p>We aim to keep Rivalo reliable, but the service may change or become unavailable during maintenance or updates.</p>
    <h2>Contact</h2>
    <p>Questions about these terms can be sent to support@rivalo.app.</p>
  </LegalPage>
</BaseLayout>
