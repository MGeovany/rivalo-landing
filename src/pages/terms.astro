---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalPage from '../components/LegalPage.astro';
import { breadcrumbSchema, webPageSchema } from '../data/jsonLd';
import { SITE } from '../data/site';

const title = 'Rivalo Terms of Use';
const description =
  'Terms and conditions for using Rivalo on iPhone and Apple Watch. Account rules, acceptable use, health disclaimers, and legal information.';
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  jsonLd={[
    webPageSchema(title, description, '/terms'),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Terms of Use', path: '/terms' }
    ])
  ]}
>
  <LegalPage title="Terms of Use" updated="June 2, 2026">
    <p>
      These Terms of Use (“Terms”) govern your access to and use of Rivalo on iPhone, Apple Watch,
      and related services (collectively, the “Service”). By creating an account or using Rivalo,
      you agree to these Terms. If you do not agree, do not use the Service.
    </p>

    <h2>About Rivalo</h2>
    <p>
      Rivalo provides football activity tracking and performance summaries for amateur players.
      The Service includes match recording on Apple Watch, sync to iPhone, statistics, goals,
      streaks, rivalries, and related features. Rivalo is intended for recreational and amateur
      use — not professional coaching, medical diagnosis, or elite performance certification.
    </p>

    <h2>Eligibility</h2>
    <ul>
      <li>You must be old enough to consent to these Terms in your jurisdiction (typically 13+ or 16+).</li>
      <li>You are responsible for the accuracy of information you provide when registering.</li>
      <li>You may not use the Service if you are barred from doing so under applicable law.</li>
    </ul>

    <h2>Your account</h2>
    <ul>
      <li>Keep your login credentials confidential.</li>
      <li>You are responsible for activity under your account.</li>
      <li>Notify us promptly at <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a> if you suspect unauthorized access.</li>
      <li>We may suspend or terminate accounts that violate these Terms or pose security risks.</li>
    </ul>

    <h2>Acceptable use</h2>
    <p>You agree not to:</p>
    <ul>
      <li>Use Rivalo for any unlawful purpose or in violation of local rules where you play</li>
      <li>Attempt to reverse engineer, scrape, overload, or disrupt the Service</li>
      <li>Upload malicious code or impersonate another person</li>
      <li>Misrepresent match data or use the Service to harass others</li>
      <li>Circumvent authentication, rate limits, or security measures</li>
    </ul>

    <h2>Health &amp; safety disclaimer</h2>
    <p>
      <strong>Rivalo is not medical advice.</strong> Metrics such as heart rate, distance, speed,
      and intensity are estimates for informational purposes. They may be inaccurate due to device
      sensors, GPS conditions, or user error. Always listen to your body, follow venue rules, and
      consult a qualified professional before starting or changing an exercise program.
    </p>
    <p>You agree to:</p>
    <ul>
      <li>Use Rivalo safely and stop activity if you feel pain, dizziness, or unsafe conditions</li>
      <li>Ensure you are physically able to participate in football activity</li>
      <li>Not rely on Rivalo as the sole basis for medical or training decisions</li>
    </ul>

    <h2>Apple Watch &amp; third-party services</h2>
    <p>
      Rivalo integrates with Apple platforms (HealthKit, WatchConnectivity, notifications) and
      cloud services (authentication, database, hosting). Your use of those platforms is also
      subject to Apple’s terms and policies. We are not responsible for third-party outages or
      changes outside our control.
    </p>

    <h2>Your content</h2>
    <p>
      You retain ownership of content you submit (notes, photos, match context). You grant us a
      limited license to store, process, and display that content solely to provide the Service.
      You represent that you have the right to submit such content and that it does not violate
      others’ rights.
    </p>

    <h2>Intellectual property</h2>
    <p>
      Rivalo, its branding, design, and software are owned by us or our licensors. These Terms do
      not grant you any rights to our trademarks or source code except the limited right to use
      the app as intended.
    </p>

    <h2>Availability &amp; changes</h2>
    <ul>
      <li>We aim to keep Rivalo reliable but do not guarantee uninterrupted availability.</li>
      <li>We may modify, suspend, or discontinue features with or without notice.</li>
      <li>We may update these Terms; continued use after the “Last updated” date constitutes acceptance.</li>
    </ul>

    <h2>Termination</h2>
    <p>
      You may stop using Rivalo at any time and request account deletion via
      <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>. We may terminate or suspend
      access if you breach these Terms or if required for legal or security reasons.
    </p>

    <h2>Disclaimer of warranties</h2>
    <p>
      THE SERVICE IS PROVIDED “AS IS” AND “AS AVAILABLE” WITHOUT WARRANTIES OF ANY KIND, EXPRESS
      OR IMPLIED, INCLUDING MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, AND NON-INFRINGEMENT.
      WE DO NOT WARRANT THAT DATA WILL BE ACCURATE, COMPLETE, OR ERROR-FREE.
    </p>

    <h2>Limitation of liability</h2>
    <p>
      TO THE MAXIMUM EXTENT PERMITTED BY LAW, RIVALO AND ITS OPERATORS WILL NOT BE LIABLE FOR ANY
      INDIRECT, INCIDENTAL, SPECIAL, CONSEQUENTIAL, OR PUNITIVE DAMAGES, OR ANY LOSS OF DATA,
      PROFITS, OR GOODWILL, ARISING FROM YOUR USE OF THE SERVICE. OUR TOTAL LIABILITY FOR ANY CLAIM
      RELATING TO THE SERVICE IS LIMITED TO THE AMOUNT YOU PAID US IN THE TWELVE MONTHS BEFORE THE
      CLAIM (OR USD $50 IF YOU USE A FREE VERSION).
    </p>

    <h2>Indemnification</h2>
    <p>
      You agree to indemnify and hold harmless Rivalo from claims arising out of your misuse of
      the Service, violation of these Terms, or infringement of third-party rights.
    </p>

    <h2>Governing law</h2>
    <p>
      These Terms are governed by the laws applicable in our place of operation, without regard to
      conflict-of-law principles. Disputes will be resolved in the courts of that jurisdiction,
      unless mandatory consumer protection laws in your country require otherwise.
    </p>

    <h2>Contact</h2>
    <div class="contact-box">
      <p>
        Questions about these Terms: <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a><br />
        Support: <a href="/support">rivalo.app/support</a><br />
        Privacy: <a href="/privacy">rivalo.app/privacy</a>
      </p>
    </div>
  </LegalPage>
</BaseLayout>
