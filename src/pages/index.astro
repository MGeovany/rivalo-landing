---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
---

<BaseLayout>
  <!-- Hero -->
  <section class="container hero">
    <div class="hero-copy">
      <h1 class="headline headline-gradient">Your match.<br />Measured clearly.</h1>
      <p class="lead">
        Start on the Watch. Rivalo captures distance, sprints, heart rate, and intensity
        during every amateur football match — then builds a clean performance summary on iPhone.
      </p>
      <div class="actions">
        <a class="button primary" href="/support">Get support</a>
        <a class="button secondary" href="/privacy">Privacy policy</a>
      </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <div class="hero-visual-glow"></div>
      <img
        src="/images/hero-performance.png"
        alt="Rivalo Performance dashboard showing distance, top speed, sprints, and match stats"
        class="hero-screenshot"
        width="390"
        height="844"
        loading="eager"
        decoding="async"
      />
    </div>
  </section>

  <!-- How it works -->
  <section class="container section how">
    <div class="section-title">
      <div class="section-title-bar"></div>
      <div>
        <p class="section-kicker">How it works</p>
        <h2>Watch → iPhone → progress</h2>
      </div>
    </div>
    <div class="steps">
      <div class="step">
        <div class="step-num">01</div>
        <h3>Start on Apple Watch</h3>
        <p>Tap start before kickoff. Live heart rate, distance, sprints, and route.</p>
      </div>
      <div class="step-arrow" aria-hidden="true">→</div>
      <div class="step">
        <div class="step-num">02</div>
        <h3>Sync to iPhone</h3>
        <p>When the match ends, your session syncs. Add score, opponent, and notes.</p>
      </div>
      <div class="step-arrow" aria-hidden="true">→</div>
      <div class="step">
        <div class="step-num">03</div>
        <h3>Review & improve</h3>
        <p>Heatmaps, personal records, streaks, and post-match insights every week.</p>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="container section features">
    <div class="features-header">
      <div class="section-title">
        <div class="section-title-bar"></div>
        <div>
          <p class="section-kicker">Built for football</p>
          <h2>Everything that matters<br />on the pitch</h2>
        </div>
      </div>
    </div>
    <div class="feature-grid">
      <FeatureCard
        icon="⌚"
        accent="orange"
        badge="Live"
        title="Live capture"
        text="Duration, distance, heart rate, intensity, sprints, and route — recorded during the match."
      />
      <FeatureCard
        icon="⚽"
        accent="gold"
        badge="Context"
        title="Match context"
        text="Opponent, score, competition, position, surface, court, goals, assists, and notes."
      />
      <FeatureCard
        icon="📊"
        accent="blue"
        badge="Stats"
        title="Performance stats"
        text="Heatmaps, sprint bursts, pitch routes, top speed, and intensity per match."
      />
      <FeatureCard
        icon="🏆"
        accent="green"
        badge="Record"
        title="Progress & records"
        text="Personal records, weekly streaks, goals, rivalries, and court stats."
      />
      <FeatureCard
        icon="🃏"
        accent="bright"
        badge="Share"
        title="Player card"
        text="Rating, tier, matches, distance, sprints, and profile photo — ready to share."
      />
      <FeatureCard
        icon="🔔"
        accent="orange"
        badge="Push"
        title="Post-match flow"
        text="Summary notifications with quick actions to review stats or log your result."
      />
    </div>
  </section>

  <!-- CTA -->
  <section class="container section cta-section">
    <div class="cta panel-hero">
      <img src="/images/isotipo.png" alt="" class="cta-icon" width="48" height="48" />
      <h2>Ready to measure every match?</h2>
      <p>Rivalo is built for amateur footballers who want honest data — not guesswork.</p>
      <div class="cta-actions">
        <a class="button primary" href="/support">Contact support</a>
        <a class="button ghost" href="/privacy">Privacy policy</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(2rem, 5vw, 3.5rem);
  }

  .headline { margin: 0 0 1.25rem; }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-visual-glow {
    position: absolute;
    inset: 8% 0 -8%;
    background: radial-gradient(ellipse at 50% 55%, rgba(255, 90, 0, 0.22), transparent 68%);
    pointer-events: none;
  }

  .hero-screenshot {
    position: relative;
    z-index: 1;
    width: min(100%, 320px);
    height: auto;
    border-radius: 36px;
    box-shadow:
      0 40px 80px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  /* ── How it works ── */
  .how .section-title { margin-bottom: 2.75rem; }

  .how .section-kicker {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
  }

  .how h2 {
    font-size: clamp(1.85rem, 4vw, 2.5rem);
    line-height: 1.1;
  }

  .steps {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: 1.25rem;
    align-items: stretch;
  }

  .step {
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-card-lg);
    background: linear-gradient(160deg, rgba(36, 37, 38, 0.95), rgba(28, 28, 30, 0.98));
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    height: 2.25rem;
    margin-bottom: 1.15rem;
    padding: 0 0.5rem;
    border-radius: 8px;
    background: rgba(255, 90, 0, 0.14);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent-bright);
  }

  .step h3 {
    margin: 0 0 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
    color: var(--text);
  }

  .step p {
    margin: 0;
    color: rgba(245, 245, 245, 0.82);
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.65;
  }

  .step-arrow {
    align-self: center;
    color: var(--accent-bright);
    font-size: 1.5rem;
    font-weight: 600;
    opacity: 0.75;
  }

  /* ── Features ── */
  .features-header { margin-bottom: 2.75rem; }

  .features .section-kicker {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
  }

  .features h2 {
    font-size: clamp(1.85rem, 4vw, 2.5rem);
    line-height: 1.1;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  @media (min-width: 961px) {
    .feature-grid {
      gap: 1.15rem;
    }
  }

  /* ── CTA ── */
  .cta-section { padding-top: 0; }

  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(2.5rem, 6vw, 4rem);
  }

  .cta-icon {
    margin-bottom: 1.25rem;
    filter: drop-shadow(0 0 20px rgba(255, 90, 0, 0.4));
  }

  .cta h2 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.05;
  }

  .cta p {
    max-width: 440px;
    margin: 0;
    color: var(--muted-soft);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  /* ── Responsive ── */
  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; }
    .hero-visual { order: -1; }
    .hero-screenshot { width: min(72vw, 280px); }
    .steps {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .step { padding: 1.5rem 1.35rem; }
    .step-arrow { display: none; }
    .feature-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 600px) {
    .feature-grid { grid-template-columns: 1fr; }
  }
</style>
