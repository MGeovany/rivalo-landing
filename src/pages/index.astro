---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import PhoneMock from '../components/PhoneMock.astro';
---

<BaseLayout>
  <!-- Hero -->
  <section class="container hero">
    <div class="hero-copy">
      <div class="eyebrow"><span class="dot"></span>Apple Watch + iPhone</div>
      <h1 class="headline headline-gradient">Your match.<br />Measured clearly.</h1>
      <p class="lead">
        Start on the Watch. Rivalo captures distance, sprints, heart rate, and intensity
        during every amateur football match — then builds a clean performance summary on iPhone.
      </p>
      <div class="actions">
        <a class="button primary" href="/support">Get support</a>
        <a class="button secondary" href="/privacy">Privacy policy</a>
      </div>
      <div class="hero-stats">
        <div class="hero-stat">
          <span class="hero-stat-value">6.8</span>
          <span class="hero-stat-label">km avg</span>
        </div>
        <div class="hero-stat-divider"></div>
        <div class="hero-stat">
          <span class="hero-stat-value">22</span>
          <span class="hero-stat-label">sprints</span>
        </div>
        <div class="hero-stat-divider"></div>
        <div class="hero-stat">
          <span class="hero-stat-value">84</span>
          <span class="hero-stat-label">rating</span>
        </div>
      </div>
    </div>
    <PhoneMock />
  </section>

  <!-- How it works -->
  <section class="container section how">
    <div class="section-title">
      <div class="section-title-bar"></div>
      <div>
        <p class="section-kicker">How it works</p>
        <h2>Watch → iPhone → progress</h2>
      </div>
    </div>
    <div class="steps">
      <div class="step">
        <div class="step-num">01</div>
        <h3>Start on Apple Watch</h3>
        <p>Tap start before kickoff. Rivalo records your workout live — heart rate, distance, sprints, and route.</p>
      </div>
      <div class="step-arrow" aria-hidden="true">→</div>
      <div class="step">
        <div class="step-num">02</div>
        <h3>Sync to iPhone</h3>
        <p>When the match ends, your session syncs automatically. Add opponent, score, goals, and notes.</p>
      </div>
      <div class="step-arrow" aria-hidden="true">→</div>
      <div class="step">
        <div class="step-num">03</div>
        <h3>Review & improve</h3>
        <p>See heatmaps, personal records, weekly streaks, rivalries, and post-match insights every week.</p>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="container section features">
    <div class="features-header">
      <div class="section-title">
        <div class="section-title-bar"></div>
        <div>
          <p class="section-kicker">Built for football</p>
          <h2>Everything that matters<br />on the pitch</h2>
        </div>
      </div>
    </div>
    <div class="feature-grid">
      <FeatureCard
        icon="⌚"
        accent="orange"
        title="Live capture"
        text="Record match duration, distance, heart rate, intensity, sprints, and route from Apple Watch."
      />
      <FeatureCard
        icon="⚽"
        accent="gold"
        title="Match context"
        text="Log opponent, score, competition, position, surface, court, goals, assists, and notes."
      />
      <FeatureCard
        icon="📊"
        accent="blue"
        title="Performance stats"
        text="Heatmaps, sprint bursts, pitch routes, top speed, and intensity breakdown per match."
      />
      <FeatureCard
        icon="🏆"
        accent="green"
        title="Progress & records"
        text="Personal records, weekly streaks, goals, rivalries, court stats, and explainable insights."
      />
      <FeatureCard
        icon="🃏"
        accent="orange"
        title="Player card"
        text="Shareable card with your rating, tier, matches, distance, sprints, and profile photo."
      />
      <FeatureCard
        icon="🔔"
        accent="gold"
        title="Post-match flow"
        text="Match summary notifications with quick actions to review stats or log your result."
      />
    </div>
  </section>

  <!-- CTA -->
  <section class="container section cta-section">
    <div class="cta panel-hero">
      <img src="/images/isotipo.png" alt="" class="cta-icon" width="48" height="48" />
      <h2>Ready to measure every match?</h2>
      <p>Rivalo is built for amateur footballers who want honest data — not guesswork.</p>
      <div class="cta-actions">
        <a class="button primary" href="/support">Contact support</a>
        <a class="button ghost" href="/privacy">Privacy policy</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(2rem, 5vw, 3.5rem);
  }

  .hero-copy .eyebrow { margin-bottom: 1.25rem; }

  .headline { margin: 0 0 1.25rem; }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .hero-stat-value {
    display: block;
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
    color: var(--text);
  }

  .hero-stat-label {
    display: block;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero-stat-divider {
    width: 1px;
    height: 36px;
    background: var(--line);
  }

  /* ── How it works ── */
  .how .section-title { margin-bottom: 2.5rem; }

  .steps {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    gap: 1rem;
    align-items: start;
  }

  .step {
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  .step-num {
    display: inline-block;
    margin-bottom: 1rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .step h3 {
    margin: 0 0 0.6rem;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .step p {
    margin: 0;
    color: var(--muted-soft);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .step-arrow {
    align-self: center;
    padding-top: 2rem;
    color: var(--accent);
    font-size: 1.25rem;
    opacity: 0.5;
  }

  /* ── Features ── */
  .features-header { margin-bottom: 2.5rem; }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  /* ── CTA ── */
  .cta-section { padding-top: 0; }

  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(2.5rem, 6vw, 4rem);
  }

  .cta-icon {
    margin-bottom: 1.25rem;
    filter: drop-shadow(0 0 20px rgba(255, 90, 0, 0.4));
  }

  .cta h2 {
    margin: 0 0 0.75rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.05;
  }

  .cta p {
    max-width: 440px;
    margin: 0;
    color: var(--muted-soft);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  /* ── Responsive ── */
  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; }
    .hero-copy { order: 1; }
    .steps {
      grid-template-columns: 1fr;
    }
    .step-arrow { display: none; }
    .feature-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 600px) {
    .feature-grid { grid-template-columns: 1fr; }
    .hero-stats { gap: 1rem; }
  }
</style>
