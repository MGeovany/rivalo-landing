---
import '../styles/global.css';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Rivalo - Football performance tracking',
  description = 'Rivalo tracks amateur football matches with Apple Watch and iPhone: live metrics, records, goals, rivalries, courts, and insights.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080906" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <footer class="container footer">
      <span>Copyright {new Date().getFullYear()} Rivalo.</span>
      <span>Built for amateur footballers.</span>
    </footer>
  </body>
</html>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--line);
    padding: 1.6rem 0 2.6rem;
    color: var(--subtle);
    font-size: 0.9rem;
  }

  @media (max-width: 620px) {
    .footer { flex-direction: column; }
  }
</style>
