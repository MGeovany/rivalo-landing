---
const links = [
  { href: '/support', label: 'Support' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' }
];
---

<header class="container nav-wrap">
  <a class="brand" href="/" aria-label="Rivalo home">
    <img src="/images/wordmark.png" alt="Rivalo" class="wordmark" width="100" height="28" />
  </a>
  <nav aria-label="Main navigation">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
</header>

<style>
  .nav-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
  }

  .wordmark {
    height: 26px;
    width: auto;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    font-size: 0.95rem;
    font-weight: 600;
  }

  nav a {
    color: var(--muted-soft);
    transition: color 0.15s ease, transform 0.15s ease;
  }

  nav a:hover {
    color: var(--accent);
    transform: translateY(-1px);
  }
</style>
