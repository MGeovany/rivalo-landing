---
interface Props {
  title: string;
  updated?: string;
}

const { title, updated } = Astro.props;
---

<section class="container legal">
  <a class="legal-back" href="/">
    <img src="/images/isotipo.png" alt="" width="20" height="20" />
    Back to Rivalo
  </a>
  <h1>{title}</h1>
  {updated && <p class="legal-updated">Last updated: {updated}</p>}
  <slot />
</section>

<style>
  .legal-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    color: var(--muted-soft);
    font-size: 0.9rem;
    font-weight: 600;
    transition: color 0.15s;
  }

  .legal-back:hover { color: var(--accent); }

  .legal-updated {
    margin: 0 0 2rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
